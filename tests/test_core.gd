extends SceneTree
const State = preload("res://scripts/game_state.gd")
const Sphere = preload("res://scripts/sphere.gd")
const Store = preload("res://scripts/save_store.gd")
var failures := 0

func check(condition: bool, message: String) -> void:
	if not condition:
		failures += 1; printerr("FAIL: ", message)
	else: print("PASS: ", message)

func _initialize() -> void:
	call_deferred("run_tests")

func run_tests() -> void:
	var state = State.new()
	check(state.quest == "available" and state.rank == "F", "initial quest and rank")
	state.interact_guild()
	check(state.quest == "active", "guild starts contract")
	var unrelated = State.new()
	unrelated.interact_guild(); unrelated.defeat("unrelated_enemy")
	check(unrelated.kills == 0, "unrelated kills do not advance slime contract")
	var early = State.new()
	for i in range(3): early.defeat("meadow_slime_%d" % i)
	early.interact_guild()
	check(early.quest == "ready", "earlier kills cannot soft-lock contract")
	check(state.defeat("meadow_slime_0") and not state.defeat("meadow_slime_0"), "defeats are idempotent")
	state.defeat("meadow_slime_1"); state.defeat("meadow_slime_2")
	check(state.quest == "ready" and state.kills == 3, "kills advance objective")
	state.interact_guild()
	check(state.quest == "completed" and state.gold == 29 and state.level == 2, "rewards and level")
	var gold: int = state.gold; state.interact_guild()
	check(state.gold == gold, "quest reward granted only once")
	check(state.discover("0:0") and not state.discover("0:0"), "discovery is idempotent")
	var dir: Vector3 = Sphere.direction(0.5, 0.2)
	var coords: Vector2 = Sphere.coordinates(dir)
	check(absf(coords.x - 0.5) < 0.0001 and absf(coords.y - 0.2) < 0.0001, "spherical coordinate round trip")
	var moved: Vector3 = Sphere.move(dir, Vector2(1, 0), 20.0)
	check(absf(moved.length() - 1.0) < 0.0001 and absf(dir.angle_to(moved) * Sphere.RADIUS - 20.0) < 0.01, "movement stays on sphere and preserves distance")
	var legacy: Dictionary = state.serialize().duplicate(true)
	legacy.version = 1
	for key in ["herb_quest", "gathered", "herbs", "potions", "sword_forged"]: legacy.erase(key)
	var migrated = State.new()
	check(migrated.restore(legacy) and migrated.herb_quest == "available" and migrated.gold == state.gold, "version 1 migration preserves existing progress")
	var progression = State.new()
	progression.interact_guild()
	for i in range(5): progression.defeat("meadow_slime_%d" % i)
	progression.interact_guild()
	progression.gather("herb_0"); progression.gather("herb_1"); progression.gather("herb_2")
	check(not progression.gather("herb_0") and progression.herbs == 3, "harvesting is persistent and idempotent")
	progression.interact_guild()
	check(progression.herb_quest == "ready", "pre-contract gathering credited")
	progression.interact_guild()
	check(progression.herb_quest == "completed" and progression.rank == "F", "herb contract rewards before promotion")
	progression.interact_guild()
	check(progression.rank == "F", "promotion requires exploration")
	progression.discover("region0")
	progression.interact_guild()
	check(progression.rank == "E", "rank E requires contracts, kills and exploration")
	progression.gather("herb_3"); progression.gather("herb_4")
	var before := progression.melee_damage()
	progression.forge_sword()
	check(progression.sword_forged and progression.melee_damage() == before + 8 and progression.herbs == 3, "forging consumes resources and increases melee damage")
	var prior_gold: int = progression.gold
	progression.forge_sword()
	check(progression.gold == prior_gold, "cannot forge same equipment twice")
	progression.craft_potion()
	check(progression.herbs == 1 and progression.potions == 1, "crafting consumes herbs")
	progression.health = 50; progression.use_potion()
	check(progression.health == 90 and progression.potions == 0, "potion heals and is consumed")
	progression.defeat("meadow_slime_5"); progression.defeat("meadow_slime_6")
	for i in range(1, 4): progression.discover("region%d" % i)
	progression.interact_guild()
	check(progression.rank == "D", "rank D requires further kills, exploration and level")
	var not_enough = State.new()
	check(not_enough.craft_potion().begins_with("Need") and not_enough.herbs == 0 and not_enough.potions == 0, "craft fails without resources")
	var progression_reload = State.new()
	check(progression_reload.restore(JSON.parse_string(JSON.stringify(progression.serialize()))) and progression_reload.rank == "D" and progression_reload.sword_forged and progression_reload.gathered.size() == 5 and progression_reload.herbs == 1, "rank and inventory save round trip")
	var serialized: Dictionary = JSON.parse_string(JSON.stringify(state.serialize()))
	var restored = State.new()
	check(restored.restore(serialized) and restored.gold == gold and restored.defeated.size() == 3, "state JSON round trip")
	serialized.direction = [0, 0, 0]
	check(not restored.restore(serialized) and restored.gold == gold, "invalid state rejected without mutation")
	var bad_inventory: Dictionary = progression.serialize().duplicate(true)
	bad_inventory.herbs = 999
	check(not progression_reload.restore(bad_inventory), "impossible inventory rejected")
	var duplicate: Dictionary = progression.serialize().duplicate(true)
	duplicate.gathered.append("herb_0")
	check(not progression_reload.restore(duplicate), "duplicate collected resource rejected")
	var path := "user://test_core_primary.json"; var backup := "user://test_core_backup.json"; var temp := "user://test_core_tmp.json"
	for file in [path, backup, temp]:
		if FileAccess.file_exists(file): DirAccess.remove_absolute(ProjectSettings.globalize_path(file))
	check(Store.save_game(state, path, backup, temp), "first save")
	state.gold += 1
	check(Store.save_game(state, path, backup, temp), "second save and backup")
	var broken := FileAccess.open(path, FileAccess.WRITE); broken.store_string("broken"); broken.close()
	var recovered = Store.load_game(path, backup)
	check(recovered != null and recovered.gold == gold, "corrupt primary recovers backup")
	var future := FileAccess.open(path, FileAccess.WRITE); future.store_string('{"version":999,"important":"do not overwrite"}'); future.close()
	check(not Store.save_game(state, path, backup, temp), "future version is not overwritten")
	var future_data := FileAccess.get_file_as_string(path)
	check(future_data.contains("do not overwrite"), "future save remains intact")
	for file in [path, backup, temp]:
		if FileAccess.file_exists(file): DirAccess.remove_absolute(ProjectSettings.globalize_path(file))
	print("Failures: ", failures)
	quit(1 if failures else 0)
